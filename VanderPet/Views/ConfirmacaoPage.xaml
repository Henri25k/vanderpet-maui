<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPet.Views.ConfirmacaoPage"
             Title="Confirmar Agendamento"
             BackgroundColor="#FFF9F3">

	<ScrollView>
		<VerticalStackLayout Padding="20,30" Spacing="20">

			<Label Text="Resumo do Pedido" FontSize="24" FontAttributes="Bold" TextColor="#D96C24"/>
			<Label Text="Quase lá! Confira os dados antes de finalizar." TextColor="#738078" Margin="0,0,0,10"/>

			<Border Stroke="#E1E8DF" BackgroundColor="#FFFFFF" Padding="20" StrokeShape="RoundRectangle 14">
				<VerticalStackLayout Spacing="15">

					<Grid ColumnDefinitions="100, *">
						<Label Grid.Column="0" Text="🐾 Pet:" FontAttributes="Bold" TextColor="#738078"/>
						<Label Grid.Column="1" x:Name="lblPet" TextColor="#26352F" FontAttributes="Bold"/>
					</Grid>

					<Grid ColumnDefinitions="100, *">
						<Label Grid.Column="0" Text="✂️ Serviço:" FontAttributes="Bold" TextColor="#738078"/>
						<Label Grid.Column="1" x:Name="lblServico" TextColor="#26352F" FontAttributes="Bold"/>
					</Grid>

					<Grid ColumnDefinitions="100, *">
						<Label Grid.Column="0" Text="📅 Data:" FontAttributes="Bold" TextColor="#738078"/>
						<Label Grid.Column="1" x:Name="lblData" TextColor="#26352F"/>
					</Grid>

					<Grid ColumnDefinitions="100, *">
						<Label Grid.Column="0" Text="⏰ Horário:" FontAttributes="Bold" TextColor="#738078"/>
						<Label Grid.Column="1" x:Name="lblHorario" TextColor="#26352F"/>
					</Grid>

					<BoxView HeightRequest="1" Color="#E1E8DF" Margin="0,5"/>

					<Grid ColumnDefinitions="*, Auto">
						<Label Grid.Column="0" Text="Total a pagar:" FontAttributes="Bold" TextColor="#26352F" VerticalOptions="Center"/>
						<Label Grid.Column="1" x:Name="lblTotal" TextColor="#D96C24" FontSize="20" FontAttributes="Bold"/>
					</Grid>

				</VerticalStackLayout>
			</Border>

			<Label Text="Observações para o Pet Shop (Opcional)" FontAttributes="Bold" TextColor="#26352F" Margin="0,10,0,0"/>
			<Border Stroke="#E1E8DF" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 14" Padding="10,5">
				<Editor x:Name="edtObservacoes" 
                        Placeholder="Ex: O Thor tem muito medo do barulho do secador..." 
                        HeightRequest="80" 
                        TextColor="#26352F" />
			</Border>

			<VerticalStackLayout Spacing="15" Margin="0,20,0,0">
				<Button Text="CONFIRMAR E AGENDAR"
                        BackgroundColor="#D96C24"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="50"
                        Clicked="OnConfirmarFinalTapped"/>

				<Button Text="VOLTAR E EDITAR"
                        BackgroundColor="Transparent"
                        TextColor="#738078"
                        FontAttributes="Bold"
                        Clicked="OnVoltarTapped"/>
			</VerticalStackLayout>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>