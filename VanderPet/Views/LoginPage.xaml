<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPet.Views.LoginPage"
             Title="Login"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#FFF9F3">

	<ScrollView>
		<VerticalStackLayout Spacing="25" 
                             Padding="28,36,28,28" 
                             VerticalOptions="CenterAndExpand">

			<VerticalStackLayout Spacing="10" HorizontalOptions="Center">
				<Border BackgroundColor="#FFF0E2" StrokeThickness="0" StrokeShape="RoundRectangle 26" Padding="16" HorizontalOptions="Center"><Label Text="🐾" FontSize="38" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" /></Border>
				<Label Text="VanderPet"
                       FontSize="34"
                       FontAttributes="Bold"
                       TextColor="#D96C24"
                       HorizontalOptions="Center" />

				<Label Text="Cuidado e carinho para o seu melhor amigo"
                       FontSize="14"
                       TextColor="#738078"
                       HorizontalOptions="Center" />
			</VerticalStackLayout>

			<VerticalStackLayout Spacing="15" Margin="0,30,0,0">

				<Border Stroke="#F0C49E" 
                        StrokeThickness="1" 
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 14"
                        Padding="10,0">
					<Entry x:Name="entEmail" 
                           Placeholder="E-mail" 
                           Keyboard="Email" 
                           TextColor="#26352F" />
				</Border>

				<Border Stroke="#F0C49E" 
                        StrokeThickness="1" 
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 14"
                        Padding="10,0">
					<Entry x:Name="entSenha" 
                           Placeholder="Senha" 
                           IsPassword="True" 
                           TextColor="#26352F" />
				</Border>

				<Label Text="Esqueci minha senha"
                       TextColor="#D96C24"
                       FontSize="14"
                       HorizontalOptions="End">
					<Label.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnEsqueciSenhaTapped" />
					</Label.GestureRecognizers>
				</Label>
			</VerticalStackLayout>

			<VerticalStackLayout Spacing="15" Margin="0,20,0,0">
				<Button Text="ENTRAR"
                        BackgroundColor="#D96C24"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="50"
                        Clicked="OnEntrarClicked"/>

				<Button Text="CRIAR CONTA"
                        BackgroundColor="#F2A93B"
                        TextColor="White"
                        BorderColor="#F2A93B"
                        BorderWidth="0"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="14"
                        HeightRequest="56"
                        Clicked="OnCriarContaClicked"/>
			</VerticalStackLayout>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>